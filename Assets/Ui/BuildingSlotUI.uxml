<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="BuildingSlotPanel" style="flex-grow: 0; flex-shrink: 1; width: 241px; background-image: none; background-color: rgba(0, 0, 0, 0); height: 113px;">
        <ui:Button text="" name="BuildingButton" style="flex-direction: row; max-height: 100%; flex-shrink: 1; max-width: none; width: 232px; background-image: url(&quot;project://database/Assets/ArtAssets/UISprite/UI%201.png?fileID=-1926156838&amp;guid=bb0eb52fcf641a0489c974d9638d0592&amp;type=3#Menu_1&quot;); padding-left: 4px; padding-right: 4px; padding-top: 6px; padding-bottom: 6px;">
            <ui:VisualElement name="LeftPanel" style="flex-grow: 0; margin-top: 9px; margin-right: 9px; margin-bottom: 9px; margin-left: 9px; height: auto; flex-shrink: 0;">
                <ui:Image name="BuildingImage" source="project://database/Assets/Placeholder/images.jpg?fileID=2800000&amp;guid=32c50bb7e9ed7a0459bed79a409531ee&amp;type=3#images" style="width: 90px; height: 90px; margin-top: -1%; margin-left: 0%;"/>
            </ui:VisualElement>
            <ui:VisualElement name="RightPanel" style="flex-grow: 1;">
                <ui:Label text="Building Name&#10;" name="BuildingName" style="padding-left: 3px; margin-right: 7px;"/>
                <ui:VisualElement name="RightBottomPanel" style="flex-grow: 0; flex-direction: row; padding-left: 0; margin-left: 8%; margin-top: 11%; margin-bottom: 13%;">
                    <ui:Image name="GoldImage" source="project://database/Assets/ArtAssets/UISprite/Coin.png?fileID=2800000&amp;guid=523428084bf0efa46b1a378d52ab0643&amp;type=3#Coin" scale-mode="ScaleToFit" style="flex-grow: 0; max-height: none; width: 32px; height: 32px;"/>
                    <ui:Label text="x" name="X"/>
                    <ui:Label text="100&#10;" name="Cost" style="flex-grow: 0; width: 41%; margin-right: 1px; margin-bottom: 2px; padding-left: 2px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
