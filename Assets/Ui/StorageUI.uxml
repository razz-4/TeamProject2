<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Ui/UI%20USS/tabs.uss?fileID=7433441132597879392&amp;guid=a06c8e8998b43964d97642a3297e6f5c&amp;type=3#tabs"/>
    <ui:VisualElement name="StorageUiPanel" style="flex-grow: 1; top: 50%; left: 50%; translate: -50% -50% 3px; max-width: 80%; max-height: 75%; background-color: rgba(0, 0, 0, 0.31); display: flex;">
        <ui:VisualElement name="StorageTopPanel" style="flex-grow: 1; min-height: 10%; max-height: 10%; background-color: rgba(0, 0, 0, 0); padding-top: 2%; padding-right: 2%; padding-bottom: 2%; padding-left: 2%; flex-direction: row;">
            <ui:VisualElement name="LeftPanel" style="flex-grow: 1;">
                <ui:Label text="Storage" name="StorageLabel" style="color: rgb(255, 255, 255);"/>
            </ui:VisualElement>
            <ui:VisualElement name="RightPanel" style="flex-grow: 1; flex-direction: row-reverse;">
                <ui:Button text="X&#10;" name="CloseButton" style="max-width: 34%;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Seperator" style="flex-grow: 1; max-height: 1px; background-color: rgb(255, 255, 255); padding-top: 0; padding-right: 4px; padding-bottom: 0; padding-left: 4px;"/>
        <ui:VisualElement name="BottomPanel" style="flex-grow: 1; padding-left: 2.5%; padding-bottom: 2.5%; padding-right: 2.5%; padding-top: 2.5%;">
            <ui:TabView name="TabView">
                <ui:Tab label="Ingredient" name="IngredientTab" focusable="true">
                    <ui:VisualElement name="Header" style="flex-grow: 1; width: 100%; height: 23px; margin-top: 6px; background-color: rgba(0, 0, 0, 0.25); flex-direction: row;">
                        <ui:Label text="Name" name="Name" style="color: rgb(255, 255, 255); margin-top: 3px; padding-left: 0%; margin-left: 28%; padding-top: 0%; padding-right: 0%; padding-bottom: 0%;"/>
                        <ui:Label text="Qty" name="Amount" style="color: rgb(255, 255, 255); padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 3px; margin-left: 34%; right: auto; transform-origin: right; translate: 0% 0%;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="Seperator" style="flex-grow: 1; background-color: rgb(255, 255, 255); width: 100%; height: 1px;"/>
                    <ui:ListView name="IngredientListView"/>
                </ui:Tab>
                <ui:Tab label="Drug" name="DrugTab">
                    <ui:VisualElement name="Header" style="flex-grow: 1; width: 100%; height: 23px; margin-top: 6px; background-color: rgba(0, 0, 0, 0.25); flex-direction: row;">
                        <ui:Label text="Name" name="Name" style="color: rgb(255, 255, 255); margin-top: 3px; padding-left: 0%; margin-left: 28%; padding-top: 0%; padding-right: 0%; padding-bottom: 0%;"/>
                        <ui:Label text="Qty" name="Amount" style="color: rgb(255, 255, 255); padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 3px; margin-left: 34%; right: auto; transform-origin: right; translate: 0% 0%;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="Seperator" style="flex-grow: 1; background-color: rgb(255, 255, 255); width: 100%; height: 1px;"/>
                    <ui:ListView name="DrugListView"/>
                </ui:Tab>
            </ui:TabView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
