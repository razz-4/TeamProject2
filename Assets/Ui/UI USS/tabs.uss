:root {
}



.unity-tab-view {
    background-color: rgba(255, 255, 255, 0);
    left: 1%;
    right: 1%;
    flex-shrink: 1;
    flex-grow: 0;
    flex-direction: column-reverse;
    align-items: stretch;
    justify-content: flex-start;
    align-self: center;
    align-content: flex-end;
    width: auto;
    height: auto;
    aspect-ratio: auto;
    padding-top: 0;
    margin-right: 0;
    padding-right: 0;
    border-top-width: 0;
    transform-origin: bottom;
    transition-timing-function: ease-in-out;
    transition-duration: 0.1s;
    font-size: 22px;
    max-width: none;
    min-width: auto;
    color: rgb(253, 0, 0);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    -unity-text-auto-size: none;
    border-right-width: 0;
    flex-wrap: nowrap;
    opacity: 1;
    display: flex;
    visibility: visible;
    overflow: visible;
    bottom: auto;
}

.unity-tab {
    background-position-y: center;
    right: 1%;
    left: 1%;
    flex-grow: 1;
    flex-direction: column-reverse;
    min-width: 100%;
    max-width: 100%;
    border-left-width: 10px;
    background-color: rgb(255, 0, 0);
    font-size: 20px;
    color: rgb(0, 0, 0);
    width: auto;
}

.unity-label {
    font-size: 44px;
}
