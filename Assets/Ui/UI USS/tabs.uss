:root {
}

.topPanel {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
    background-color: rgba(255, 211, 114, 0);
    width: auto;
    min-width: auto;
    padding-left: 5%;
    padding-right: 5%;
    margin-top: 5%;
    margin-right: 5%;
    margin-bottom: 5%;
    margin-left: 5%;
    max-width: none;
    transform-origin: center;
    translate: 0% 0%;
    flex-wrap: nowrap;
    flex-shrink: 1;
    flex-grow: 1;
    flex-direction: column;
    font-size: 13px;
    -unity-text-align: middle-center;
    flex-basis: auto;
    align-items: center;
    justify-content: flex-start;
    align-self: auto;
    height: auto;
    max-height: none;
    min-height: auto;
    left: 0%;
    top: 0%;
    border-left-width: 1px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.topPanelLabel {
    font-size: 14px;
    -unity-font-style: bold;
    flex-direction: column;
    -unity-text-align: lower-center;
    translate: 0% -50%;
    top: 50%;
    width: 90%;
    min-height: auto;
    height: 50%;
}

.customButton {
    background-color: rgb(255, 211, 114);
    border-left-width: 1px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
}

.unity-tab-view__header-container {
    flex-grow: 1;
}

.unity-tab__header {
    flex-grow: 1;
    -unity-font-style: normal;
    -unity-text-align: upper-center;
    max-width: 50%;
}

.unity-tab__header-label {
    -unity-text-align: upper-center;
    left: 50%;
    translate: -50% 0;
    font-size: 9px;
}

#MainUI > #BuildingPanel-Panel > #Building-ScrollView > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container {
    background-image: none;
    min-height: 100px;
    max-height: 100px;
}
