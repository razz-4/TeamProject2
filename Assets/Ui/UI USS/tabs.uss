:root {
}

.topPanel {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgb(255, 211, 114);
    width: auto;
    min-width: auto;
    padding-left: 5%;
    padding-right: 5%;
    margin-top: 5%;
    margin-right: 5%;
    margin-bottom: 5%;
    margin-left: 5%;
    max-width: none;
    transform-origin: center;
    translate: 0% 0%;
    flex-wrap: nowrap;
    flex-shrink: 1;
    flex-grow: 1;
    flex-direction: column;
    font-size: 13px;
    -unity-text-align: middle-center;
    flex-basis: auto;
    align-items: center;
    justify-content: flex-start;
    align-self: auto;
    height: auto;
    max-height: 50%;
    min-height: 50%;
    left: 0%;
    top: 0%;
    border-left-width: 1px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
}

.topPanelLabel {
    font-size: 14px;
    -unity-font-style: bold;
    flex-direction: column;
    -unity-text-align: lower-center;
    translate: 0% -50%;
    top: 50%;
    width: 90%;
    min-height: auto;
    height: 50%;
}

#BottomTab #unity-tab-view__header-container {
    width: auto;
    flex-grow: 1;
    align-self: stretch;
    flex-direction: row;
    min-height: 100%;
}

#BottomTab .unity-tab__header {
    flex-grow: 1;
    flex-basis: auto;
    flex-shrink: 1;
    align-self: auto;
    flex-direction: column-reverse;
    flex-wrap: nowrap;
    font-size: 14px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-right: 1px;
    max-width: 33.33%;
    translate: 1% 0;
    padding-left: 1px;
    min-width: 33.33%;
    min-height: auto;
    max-height: none;
    aspect-ratio: auto;
    -unity-text-align: middle-center;
}

#BottomTab .unity-tab-view__content-viewport {
    flex-grow: 0;
    width: 100%;
    height: 10%;
}
