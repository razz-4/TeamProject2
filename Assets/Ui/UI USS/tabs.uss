:root {
}





.topPanel {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgb(255, 211, 114);
    width: auto;
    min-width: auto;
    padding-left: 30px;
    padding-right: 30px;
    margin-top: 40px;
    margin-right: 50px;
    margin-bottom: 30px;
    margin-left: 50px;
    max-width: none;
    transform-origin: center;
    translate: 0% 0;
    flex-wrap: nowrap;
    flex-shrink: 1;
    flex-grow: 1;
}

.topPanelLabel {
    font-size: 40px;
    -unity-font-style: bold;
}

.bottomTabs {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-end;
    align-content: flex-end;
    align-self: auto;
    min-width: 33%;
    flex-basis: 0;
    flex-grow: 1;
}



.unity-tab-view {
    width: 100%;
    font-size: 21px;
    padding-left: 0;
    padding-right: 0;
    margin-left: 0;
    margin-bottom: 0;
    margin-top: 0;
}

.unity-tab_header {
    width: 30%;
}
