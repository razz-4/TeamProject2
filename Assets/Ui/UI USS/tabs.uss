:root {
}

.topPanel {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgb(255, 211, 114);
    width: auto;
    min-width: auto;
    padding-left: 30px;
    padding-right: 30px;
    margin-top: 40px;
    margin-right: 50px;
    margin-bottom: 30px;
    margin-left: 50px;
    max-width: none;
    transform-origin: center;
    translate: 0% 0;
    flex-wrap: nowrap;
    flex-shrink: 1;
    flex-grow: 1;
    flex-direction: column;
}

.topPanelLabel {
    font-size: 40px;
    -unity-font-style: bold;
    flex-direction: column;
}





#BottomTab #unity-tab-view__header-container {
    width: auto;
    flex-grow: 1;
    align-self: stretch;
}

#BottomTab .unity-tab__header {
    flex-grow: 1;
    flex-basis: auto;
    flex-shrink: 1;
    align-self: auto;
    flex-direction: column-reverse;
    flex-wrap: nowrap;
    font-size: 43px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-right: 0;
    max-width: 33.333%;
}

#BottomTab .unity-tab-view__content-viewport {
    flex-grow: 0;
    width: 100%;
}
