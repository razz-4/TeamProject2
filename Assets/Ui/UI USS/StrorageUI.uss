:root {
}

.mainPanel {
    background-image: url("project://database/Assets/ArtAssets/UISprite/UI2.png?fileID=-72773568&guid=10c7186369d27c144a24b35215e72dc7&type=3#Menu3");
    translate: -50% -50%;
    flex-grow: 1;
    top: 50%;
    left: 50%;
    max-width: 79%;
    max-height: 75%;
    background-color: rgba(0, 0, 0, 0);
    display: flex;
    padding-left: 2.5%;
    padding-right: 2.5%;
    padding-top: 17%;
    padding-bottom: 2%;
    transition-duration: 0.7s;
    transition-timing-function: ease-in;
    opacity: 1;
}

.tabHeader {
    background-color: rgb(0, 0, 0);
    background-image: url("project://database/Assets/ArtAssets/UISprite/UI%201.png?fileID=1977660974&guid=bb0eb52fcf641a0489c974d9638d0592&type=3#Menu_2");
}

.MainPanelUp {
    translate: -50% -200%;
}
