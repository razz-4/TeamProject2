:root {
}

.SettingDefault {
    flex-grow: 1;
    max-width: 80%;
    max-height: 75%;
    left: 50%;
    top: 50%;
    padding-top: 17%;
    padding-right: 3%;
    padding-bottom: 2.5%;
    padding-left: 3%;
    background-color: rgba(111, 111, 111, 0);
    display: flex;
    transform-origin: center;
    opacity: 1;
    translate: -50% -50% 3px;
}

.SettingUp {
    translate: -50% -176%;
    opacity: 0;
}
