:root {
}

.customPanel {
    background-image: url("project://database/Assets/ArtAssets/UISprite/UI%201.png?fileID=631528754&guid=bb0eb52fcf641a0489c974d9638d0592&type=3#Blue Menu");
}

.customButtons {
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: -1px;
    border-top-right-radius: -1px;
    border-bottom-right-radius: -1px;
    border-bottom-left-radius: 0;
}

.customMainUIPanel {
    background-image: url("project://database/Assets/ArtAssets/UISprite/UI%201.png?fileID=-1926156838&guid=bb0eb52fcf641a0489c974d9638d0592&type=3#Menu_1");
    margin-right: 5%;
    margin-left: 5%;
    margin-top: 5%;
}

.customMainButton {
    background-image: url("project://database/Assets/ArtAssets/UISprite/UI%201.png?fileID=2056972610&guid=bb0eb52fcf641a0489c974d9638d0592&type=3#Green Menu");
}

.mainPanel {
    background-image: url("project://database/Assets/ArtAssets/UISprite/UI2.png?fileID=-72773568&guid=10c7186369d27c144a24b35215e72dc7&type=3#Menu3");
}
