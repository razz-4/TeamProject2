<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="BuyerSlotUI" style="flex-grow: 0; max-height: 100%; background-color: rgba(111, 111, 111, 0); padding-top: 2%; padding-right: 2%; padding-bottom: 2%; padding-left: 2%; flex-direction: row; margin-top: 2%; margin-right: 2%; margin-bottom: 2%; margin-left: 2%;">
        <ui:VisualElement name="LeftPanel" style="flex-grow: 1; min-height: auto; min-width: 50%; max-width: 50%; font-size: 10px;">
            <ui:Label text="Name&#10;" name="BuyerName" style="flex-grow: 1; font-size: 12px; -unity-text-align: middle-left; margin-left: 9%; padding-left: 2px; color: rgb(255, 255, 255);"/>
        </ui:VisualElement>
        <ui:VisualElement name="RightPanel" style="flex-grow: 1; flex-direction: row-reverse; min-width: 50%; max-width: 50%;">
